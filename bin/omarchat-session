#!/bin/bash

set -euo pipefail

here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
backends="$(dirname "$here")/backends"
# shellcheck source=SCRIPTDIR/../backends/lib.sh
source "$backends/lib.sh"

IFS=$'\t' read -r agent model _ < <("$here/omarchat-model")
backend="$backends/$agent"

if [[ $agent == "none" ]]; then
  echo "No agent has been set up yet." >&2
  exit 1
fi
if [[ ! -x $backend ]]; then
  echo "Omarchat doesn't support the agent '$agent'. Pick another model in settings (Ctrl+,)." >&2
  exit 1
fi
if ! reason=$("$backend" check); then
  echo "$(omarchat_agent_name "$agent"): $reason" >&2
  exit 1
fi
if ! command -v bwrap >/dev/null; then
  echo "Omarchat runs sandboxed and needs bubblewrap: omarchy pkg add bubblewrap" >&2
  exit 1
fi

OMARCHAT_AGENT_BIN=$(readlink -f "$(omarchat_agent_bin "$agent")")
export OMARCHAT_AGENT_BIN

OMARCHAT_SYSTEM_PROMPT="You are Omarchat, a quick-answer assistant summoned from the \
Omarchy desktop launcher (Arch Linux + Hyprland). The user wants a fast, direct \
answer and will discard the conversation afterwards. Today is $(date '+%A, %B %-d, %Y').

- Lead with the answer. Keep it short unless asked for depth.
- Use Markdown sparingly: short lists, inline code, fenced code blocks for commands.
- Search the web when the question depends on current or specific facts you are \
not sure of. Prefer one search; only dig further when it falls short.
- When you used the web, end with the sources as short Markdown links."
export OMARCHAT_SYSTEM_PROMPT

plugin_root=$(dirname "$here")
agent_root=$(dirname "$OMARCHAT_AGENT_BIN")
readable=(--ro-bind "$plugin_root" "$plugin_root" --ro-bind "$agent_root" "$agent_root")
writable=()
while IFS= read -r path; do
  [[ -n $path ]] && writable+=(--bind-try "$path" "$path")
done < <("$backend" paths)

exec bwrap \
  --ro-bind / / \
  --dev /dev \
  --proc /proc \
  --tmpfs /tmp \
  --tmpfs "$HOME" \
  "${readable[@]}" \
  "${writable[@]}" \
  --chdir /tmp \
  --unshare-pid \
  --unshare-ipc \
  --unshare-uts \
  --die-with-parent \
  --new-session \
  -- "$backend" session "$model"
