#!/bin/bash

# omarchat-session
#
# One ephemeral Omarchat conversation with the selected agent and model
# (omarchat-model). The chat card writes {"text": ...} lines to stdin and reads
# Omarchat events from stdout (see backends/lib.sh). The process lives exactly
# as long as the card, so closing the card is the end of the conversation.
#
# Whatever the agent, the session can search the web and nothing else:
#
# - Each backend allows a search tool and no other tool. Claude Code's
#   WebSearch runs on Anthropic's servers; Pi gets Omarchat's web_search, which
#   only sends a query to a fixed search service. Neither takes a URL, so the
#   model can't reach this machine or the local network.
# - The agent runs in a bubblewrap sandbox: the filesystem is read-only, /tmp
#   is private, and $HOME is an empty tmpfs. Only Omarchat itself and the
#   agent's own program come back (read-only), plus the agent's state
#   (`<backend> paths`, writable, for token refreshes). Documents, keys, and
#   other configs aren't there to read, whatever tools an agent turns out to
#   have. It dies with the card that started it.

set -euo pipefail

here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
backends="$(dirname "$here")/backends"
# shellcheck source=SCRIPTDIR/../backends/lib.sh
source "$backends/lib.sh"

IFS=$'\t' read -r agent model _ < <("$here/omarchat-model")
backend="$backends/$agent"

# Fail with something readable: the chat card shows stderr when the session
# exits before answering.
if [[ $agent == "none" ]]; then
  echo "No agent has been set up yet." >&2
  exit 1
fi
if [[ ! -x $backend ]]; then
  echo "Omarchat doesn't support the agent '$agent'. Pick another model in settings (Ctrl+,)." >&2
  exit 1
fi
if ! reason=$("$backend" check); then
  echo "$(omarchat_agent_name "$agent"): $reason" >&2
  exit 1
fi
if ! command -v bwrap >/dev/null; then
  echo "Omarchat runs sandboxed and needs bubblewrap: omarchy pkg add bubblewrap" >&2
  exit 1
fi

# The real path: links like mise's installs/<agent>/latest point into a part
# of $HOME the sandbox hides.
OMARCHAT_AGENT_BIN=$(readlink -f "$(omarchat_agent_bin "$agent")")
export OMARCHAT_AGENT_BIN

OMARCHAT_SYSTEM_PROMPT="You are Omarchat, a quick-answer assistant summoned from the \
Omarchy desktop launcher (Arch Linux + Hyprland). The user wants a fast, direct \
answer and will discard the conversation afterwards. Today is $(date '+%A, %B %-d, %Y').

- Lead with the answer. Keep it short unless asked for depth.
- Use Markdown sparingly: short lists, inline code, fenced code blocks for commands.
- Search the web when the question depends on current or specific facts you are \
not sure of. Prefer one search; only dig further when it falls short.
- When you used the web, end with the sources as short Markdown links."
export OMARCHAT_SYSTEM_PROMPT

# Put back what a session needs from under $HOME: this plugin (backends,
# translations, the Pi search tool) and the agent's own program, read-only.
plugin_root=$(dirname "$here")
agent_root=$(dirname "$OMARCHAT_AGENT_BIN")
readable=(--ro-bind "$plugin_root" "$plugin_root" --ro-bind "$agent_root" "$agent_root")
writable=()
while IFS= read -r path; do
  [[ -n $path ]] && writable+=(--bind-try "$path" "$path")
done < <("$backend" paths)

exec bwrap \
  --ro-bind / / \
  --dev /dev \
  --proc /proc \
  --tmpfs /tmp \
  --tmpfs "$HOME" \
  "${readable[@]}" \
  "${writable[@]}" \
  --chdir /tmp \
  --unshare-pid \
  --unshare-ipc \
  --unshare-uts \
  --die-with-parent \
  --new-session \
  -- "$backend" session "$model"
