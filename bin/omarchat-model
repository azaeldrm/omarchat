#!/bin/bash

# omarchat-model                              agent, model, and name, tab-separated;
#                                             agent "none" when no agent is usable
# omarchat-model --label                      "<model name> · <agent name>", for the header
# omarchat-model --probe                      both of the above, one per line
# omarchat-model set <agent> <model> [name]   choose what the next chat uses
# omarchat-model unavailable <reason>         remember the current model was refused
#
# The settings view in the chat card lists the choices (omarchat-models) and
# calls `set`. Until something usable is chosen, the first usable agent's own
# default stands in (Claude Haiku 5.5 for Claude Code, Pi's default model for
# Pi), so a first chat works with whichever agent is set up. The stand-in isn't
# saved: install or log in to another agent and the next chat follows.

set -euo pipefail

here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
backends="$(dirname "$here")/backends"
# shellcheck source=SCRIPTDIR/../backends/lib.sh
source "$backends/lib.sh"

# OMARCHAT_MODEL_FILE lets the tests use their own selection.
selection_file="${OMARCHAT_MODEL_FILE:-$HOME/.config/omarchy/omarchat/model}"

usable() {
  [[ -x $backends/$1 ]] && "$backends/$1" check >/dev/null 2>&1
}

fallback() {
  local entry agent pick
  for entry in "${omarchat_agents[@]}"; do
    agent=${entry%%:*}
    usable "$agent" || continue
    pick=$("$backends/$agent" default 2>/dev/null) || continue
    [[ -n $pick ]] || continue
    jq -r --arg agent "$agent" '[$agent, .id, .name] | @tsv' <<<"$pick"
    return
  done
  # Nothing usable: the card shows how to set an agent up instead of a chat.
  printf 'none\t\t\n'
}

current() {
  local line=""
  [[ -s $selection_file ]] && IFS= read -r line <"$selection_file"
  # A saved large model (see lib.sh) is no longer offered; fall back.
  if [[ -n $line ]] && ! omarchat_is_large "$line" && usable "${line%%$'\t'*}"; then
    echo "$line"
  else
    fallback
  fi
}

# The last label, for the card to show the moment it opens; --probe then
# confirms it. Empty when no agent is usable.
label_file="${XDG_CACHE_HOME:-$HOME/.cache}/omarchat/label"

save_label() {
  mkdir -p "$(dirname "$label_file")"
  printf '%s\n' "$1" >"$label_file"
}

# The header label for a current() line; saved for the next open.
label() {
  local agent model name
  IFS=$'\t' read -r agent model name <<<"$1"
  if [[ $agent == "none" ]]; then
    save_label ""
    echo "No agent set up"
  else
    save_label "${name:-$model} · $(omarchat_agent_name "$agent")"
    echo "${name:-$model} · $(omarchat_agent_name "$agent")"
  fi
}

case "${1:-}" in
"")
  current
  ;;

--label)
  label "$(current)"
  ;;

--probe)
  line=$(current)
  echo "$line"
  label "$line"
  ;;

set)
  agent=${2:?usage: omarchat-model set <agent> <model> [name]}
  model=${3:?usage: omarchat-model set <agent> <model> [name]}
  name=${4:-$model}
  mkdir -p "$(dirname "$selection_file")"
  printf '%s\t%s\t%s\n' "$agent" "$model" "$name" >"$selection_file"
  save_label "$name · $(omarchat_agent_name "$agent")"
  ;;

unavailable)
  # The chat card calls this when a model is refused for good (not on this
  # plan or account); omarchat-models greys it out with the reason.
  reason=${2:-Not available}
  IFS=$'\t' read -r agent model _ < <(current)
  file="${XDG_CACHE_HOME:-$HOME/.cache}/omarchat/unavailable.json"
  mkdir -p "$(dirname "$file")"
  [[ -s $file ]] || echo '{}' >"$file"
  jq --arg key "$agent/$model" --arg reason "$reason" --argjson now "$(date +%s)" \
    '.[$key] = {reason: $reason, at: $now}' "$file" >"$file.tmp"
  mv "$file.tmp" "$file"
  ;;

*)
  echo "usage: omarchat-model [--label | --probe | set <agent> <model> [name] | unavailable <reason>]" >&2
  exit 2
  ;;
esac
