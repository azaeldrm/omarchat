#!/bin/bash

set -euo pipefail

here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck source=SCRIPTDIR/lib.sh
source "$here/lib.sh"

case "${1:-}" in
check)
  if ! omarchat_agent_bin claude >/dev/null; then
    echo "Not installed"
    exit 1
  fi
  if [[ ! -s $HOME/.claude/.credentials.json && -z ${ANTHROPIC_API_KEY:-} ]]; then
    echo "Not logged in"
    exit 1
  fi
  ;;

models)
  printf '%s\n' \
    '{"id":"claude-haiku-5-5","name":"Claude Haiku 5.5"}' \
    '{"id":"claude-sonnet-5-5","name":"Claude Sonnet 5.5"}'
  ;;

default)
  echo '{"id":"claude-haiku-5-5","name":"Claude Haiku 5.5"}'
  ;;

paths)
  printf '%s\n' "$HOME/.claude" "$HOME/.claude.json"
  ;;

encode)
  jq --unbuffered -c '{type: "user", message: {role: "user", content: .text}}'
  ;;

translate)
  jq --unbuffered -c -f "$here/claude.jq"
  ;;

session)
  model=${2:?usage: claude session <model>}
  bin=$(omarchat_agent_bin claude)

  "$0" encode |
    "$bin" -p \
      --input-format stream-json \
      --output-format stream-json \
      --include-partial-messages \
      --verbose \
      --model "$model" \
      --tools WebSearch \
      --allowedTools WebSearch \
      --setting-sources "" \
      --strict-mcp-config \
      --no-session-persistence \
      --disable-slash-commands \
      --system-prompt "${OMARCHAT_SYSTEM_PROMPT:-}" |
    "$0" translate
  ;;

*)
  echo "usage: claude check|models|default|paths|encode|translate|session <model>" >&2
  exit 2
  ;;
esac
