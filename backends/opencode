#!/bin/bash

set -euo pipefail

here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck source=SCRIPTDIR/lib.sh
source "$here/lib.sh"

data_dir=${XDG_DATA_HOME:-$HOME/.local/share}/opencode
auth_file=$data_dir/auth.json

opencode_env() {
  # Export a search-only opencode environment: opencode_env <scratch> [model].
  mkdir -p "$1/config"
  export XDG_CONFIG_HOME=$1/config
  export OPENCODE_PURE=1 OPENCODE_ENABLE_EXA=1
  export OPENCODE_DISABLE_PROJECT_CONFIG=1 OPENCODE_DISABLE_CLAUDE_CODE=1
  export OPENCODE_DISABLE_AUTOUPDATE=1 OPENCODE_DISABLE_LSP_DOWNLOAD=1 OPENCODE_DISABLE_SHARE=1
  OPENCODE_CONFIG_CONTENT=$(jq -nc --arg model "${2:-}" --arg prompt "${OMARCHAT_SYSTEM_PROMPT:-}" '
    {permission: {"*": "deny", websearch: "allow"}} as $searchOnly
    | {
        autoupdate: false, share: "disabled", snapshot: false,
        plugin: [], mcp: {}, lsp: false, formatter: false, instructions: [],
        permission: $searchOnly.permission,
        default_agent: "omarchat",
        agent: {
          build: {disable: true}, plan: {disable: true},
          general: {disable: true}, explore: {disable: true},
          omarchat: ({mode: "primary", description: "Omarchat", permission: $searchOnly.permission}
            + if $prompt != "" then {prompt: $prompt} else {} end)
        }
      }
    + if $model != "" then {model: $model} else {} end')
  export OPENCODE_CONFIG_CONTENT
}

list_models() {
  # The models this account can use, as {"id", "name", "provider", "released"} lines.
  local bin scratch
  bin=$(omarchat_agent_bin opencode)
  scratch=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf '$scratch'" RETURN
  opencode_env "$scratch"
  (cd /tmp && "$bin" models --verbose 2>/dev/null) | sed '/^[^{} ]/d' |
    jq -c --argjson zen "$(jq 'has("opencode")' "$auth_file" 2>/dev/null || echo false)" '
      select(.capabilities.toolcall != false and .status != "deprecated")
      | select(.providerID != "opencode" or $zen)
      | {id: "\(.providerID)/\(.id)", name: (.name // .id), provider: .providerID, released: (.release_date // "")}' | omarchat_drop_large
}

rpc() {
  # Print a JSON-RPC request: rpc <id> <method> <params-json>.
  jq -nc --argjson id "$1" --arg method "$2" --argjson params "$3" '{jsonrpc: "2.0", id: $id, method: $method, params: $params}'
}

await() {
  # Read agent output until the response to request <id>; print it.
  local line
  while IFS= read -r line <&4; do
    if jq -e --argjson id "$1" '.id == $id and (has("result") or has("error"))' <<<"$line" >/dev/null 2>&1; then
      echo "$line"
      return 0
    fi
  done
  return 1
}

case "${1:-}" in
check)
  if ! omarchat_agent_bin opencode >/dev/null; then
    echo "Not installed"
    exit 1
  fi
  if ! jq -e 'del(.opencode) | length > 0' "$auth_file" >/dev/null 2>&1 &&
    ! env | grep -q -E '^[A-Z0-9_]+_API_KEY='; then
    echo "Not logged in"
    exit 1
  fi
  ;;

models)
  list_models | jq -c '{id, name, provider}'
  ;;

default)
  models=$(list_models)
  recent=$(jq -r '.recent[0] | select(.) | "\(.providerID)/\(.modelID)"' \
    "${XDG_STATE_HOME:-$HOME/.local/state}/opencode/model.json" 2>/dev/null || true)
  pick=$(jq -c --arg id "$recent" 'select(.id == $id) | {id, name}' <<<"$models" | head -1)
  [[ -n $pick ]] || pick=$(jq -sc 'sort_by(.released, -(.name | length)) | last | select(.) | {id, name}' <<<"$models")
  [[ -n $pick ]] && echo "$pick"
  ;;

paths)
  printf '%s\n' "$auth_file" "${XDG_CACHE_HOME:-$HOME/.cache}/opencode/models.json"
  ;;

encode)
  jq --unbuffered -c '[{type: "text", text: .text}]'
  ;;

translate)
  jq -n --unbuffered -c -f "$here/opencode.jq"
  ;;

session)
  model=${2:?usage: opencode session <model>}
  bin=$(omarchat_agent_bin opencode)
  workdir=$(mktemp -d)
  opencode_env "$workdir" "$model"
  mkfifo "$workdir/in" "$workdir/out"
  (cd /tmp && exec "$bin" acp) <"$workdir/in" >"$workdir/out" &
  agent_pid=$!
  exec 3>"$workdir/in" 4<"$workdir/out"
  trap 'exec 3>&-; kill "$agent_pid" 2>/dev/null; rm -rf "$workdir"' EXIT

  rpc 0 initialize "$(jq -nc --arg version "$(omarchat_version)" '{
    protocolVersion: 1,
    clientCapabilities: {fs: {readTextFile: false, writeTextFile: false}, terminal: false},
    clientInfo: {name: "omarchat", title: "Omarchat", version: $version}
  }')" >&3
  await 0 >/dev/null
  rpc 1 session/new '{"cwd":"/tmp","mcpServers":[]}' >&3
  started=$(await 1)
  session=$(jq -r '.result.sessionId // empty' <<<"$started")
  if [[ -z $session ]]; then
    echo "opencode couldn't start a chat: $(jq -r '.error.message // "no session"' <<<"$started")" >&2
    exit 1
  fi
  current=$(jq -r '.result.configOptions[]? | select(.id == "model") | .currentValue' <<<"$started")
  if [[ $current != "$model" ]]; then
    jq -nc --arg model "$model" '{type: "error", text: "\($model) is not available in opencode."}, {type: "done"}'
    exit 0
  fi

  {
    while IFS= read -r line; do
      if jq -e 'has("id") and has("method")' <<<"$line" >/dev/null 2>&1; then
        jq -c '
          if .method == "session/request_permission" then
            {jsonrpc: "2.0", id, result: {outcome: (
              [.params.options[]? | select(.kind | startswith("reject"))][0]
              | if . then {outcome: "selected", optionId} else {outcome: "cancelled"} end)}}
          else {jsonrpc: "2.0", id, error: {code: -32601, message: "Omarchat does not support this request"}} end' <<<"$line" >&3
      else
        [[ -n ${OMARCHAT_OPENCODE_RECORD:-} ]] && echo "$line" >>"$OMARCHAT_OPENCODE_RECORD"
        echo "$line"
      fi
    done <&4
  } | "$0" translate &
  reader=$!

  id=2
  "$0" encode | while IFS= read -r prompt; do
    rpc "$id" session/prompt "$(jq -nc --arg session "$session" --argjson prompt "$prompt" '{sessionId: $session, prompt: $prompt}')" >&3
    id=$((id + 1))
  done
  kill "$agent_pid" 2>/dev/null || true
  wait "$reader" 2>/dev/null || true
  ;;

*)
  echo "usage: opencode check|models|default|paths|encode|translate|session <model>" >&2
  exit 2
  ;;
esac
