#!/bin/bash

set -euo pipefail

here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck source=SCRIPTDIR/lib.sh
source "$here/lib.sh"

case "${1:-}" in
check)
  if ! omarchat_agent_bin pi >/dev/null; then
    echo "Not installed"
    exit 1
  fi
  if ! jq -e 'length > 0' "$HOME/.pi/agent/auth.json" >/dev/null 2>&1 &&
    [[ ! -s $HOME/.pi/agent/models.json ]] &&
    ! env | grep -q -E '^[A-Z0-9_]+_API_KEY='; then
    echo "Not logged in"
    exit 1
  fi
  ;;

models)
  bin=$(omarchat_agent_bin pi)
  coproc PI { cd /tmp && exec "$bin" --mode rpc --no-session --no-tools --no-mcp --no-skills --no-prompt-templates 2>/dev/null; }
  printf '%s\n' '{"id":"models","type":"get_available_models"}' >&"${PI[1]}"
  while IFS= read -r -t 30 line <&"${PI[0]}"; do
    if jq -e '.type == "response" and .id == "models"' <<<"$line" >/dev/null 2>&1; then
      jq -c '.data.models[]? | {
        id: "\(.provider)/\(.id)",
        name: (if (.name // "") != "" then .name else .id end),
        provider: .provider
      }' <<<"$line" | omarchat_drop_large
      break
    fi
  done
  kill "$PI_PID" 2>/dev/null || true
  ;;

default)
  models=$("$0" models)
  wanted=$(jq -r '[.defaultProvider, .defaultModel] | select(all(. != null)) | join("/")' \
    "$HOME/.pi/agent/settings.json" 2>/dev/null || true)
  pick=$(jq -c --arg id "$wanted" 'select(.id == $id) | {id, name}' <<<"$models" | head -1)
  [[ -n $pick ]] || pick=$(head -1 <<<"$models" | jq -c '{id, name}')
  [[ -n $pick ]] && echo "$pick"
  ;;

paths)
  printf '%s\n' "$HOME/.pi/agent"
  ;;

encode)
  jq --unbuffered -c '{type: "prompt", message: .text}'
  ;;

translate)
  jq --unbuffered -c -f "$here/pi.jq"
  ;;

session)
  model=${2:?usage: pi session <model>}
  bin=$(omarchat_agent_bin pi)

  "$0" encode |
    "$bin" --mode rpc \
      --no-session \
      --no-mcp \
      --no-skills \
      --no-prompt-templates \
      --tools web_search \
      -e "$here/pi-web-search.ts" \
      --model "$model" \
      --system-prompt "${OMARCHAT_SYSTEM_PROMPT:-}" |
    "$0" translate
  ;;

*)
  echo "usage: pi check|models|default|paths|encode|translate|session <model>" >&2
  exit 2
  ;;
esac
